# DAKSHU AI - Local Model Configuration Template
PROJECT_NAME="DAKSHU AI"
DEBUG=True
PORT=8000
HOST=0.0.0.0

SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

DATABASE_URL="sqlite:///./dakshu.db"

# Active AI Backend: Local Inference
# Options: "ollama", "transformers", "builtin"
AI_BACKEND="ollama"

# Local Ollama Settings (Custom fine-tuned Dakshu model or base Gemma 2)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="dakshu"
OLLAMA_FALLBACK_MODEL="gemma2:2b"

# Local Transformers / PyTorch Model Settings (Optional)
LOCAL_MODEL_PATH="./model/dakshu-merged"
HF_MODEL_ID="google/gemma-2-2b-it"

# Generation Controls
MAX_HISTORY_TURNS=10
MAX_TOKENS_OUTPUT=1024
TEMPERATURE=0.7
